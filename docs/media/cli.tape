# usage-cli against the synthetic demo digest — see tui.tape.
Output frames/
Set Shell zsh
Set FontSize 15
Set Width 1180
Set Height 600
Set TypingSpeed 45ms
Set Theme { "background": "#161618", "foreground": "#d8d8d8" }

Hide
Type "PS1='$ ' && setopt interactivecomments && clear" Enter
Sleep 500ms
Show
Type "usage-cli limits" Enter
Sleep 2s
Type "usage-cli limit session percent" Enter
Sleep 1500ms
Type "usage-cli models" Enter
Sleep 2s
Type "usage-cli sessions" Enter
Sleep 2500ms
Type "usage-cli prompt   # a status-line segment" Enter
Sleep 3s
